# PhishGuard AI - Environment Configuration Example
#
# PhishGuard AI requires ZERO API keys and ZERO paid services to function.
# This file exists only to document OPTIONAL future integrations (see
# app/threat_intel/manager.py and docs/architecture.md). Nothing here is
# read by the application today; it is provided as a forward-looking
# placeholder for anyone who wants to wire in an OPTIONAL free threat-intel
# source later.
#
# The application must and does work correctly with this file absent.

# OPTIONAL - example placeholder for a future free threat-intel integration.
# PHISHGUARD_OPTIONAL_FEED_URL=

# OPTIONAL - log level override (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# PHISHGUARD_LOG_LEVEL=INFO
